generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  buyer
  agent
  admin
}

enum ListingType {
  sale
  rent
}

enum PropertyType {
  house
  condominium
  townhouse
  villa
  penthouse
  lot
}

enum ListingStatus {
  draft
  pending
  published
  sold
  archived
}

enum InquiryStatus {
  new
  contacted
  closed
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(buyer)
  fullName     String
  phone        String?
  agency       String?
  licenseNo    String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings  Property[] @relation("AgentListings")
  favorites Favorite[]
  inquiries Inquiry[]  @relation("BuyerInquiries")

  @@map("users")
}

model Property {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  agentId       String        @db.Uuid
  title         String
  description   String
  listingType   ListingType
  propertyType  PropertyType
  status        ListingStatus @default(draft)
  pricePhp      BigInt
  bedrooms      Int
  bathrooms     Decimal       @db.Decimal(4, 1)
  floorAreaSqm  Decimal       @db.Decimal(10, 2)
  lotAreaSqm    Decimal?      @db.Decimal(12, 2)
  parkingSlots  Int           @default(0)
  neighborhood  String
  city          String
  province      String
  address       String
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  amenities     String[]      @default([])
  yearBuilt     Int?
  featured      Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  agent     User            @relation("AgentListings", fields: [agentId], references: [id], onDelete: Restrict)
  images    PropertyImage[]
  favorites Favorite[]
  inquiries Inquiry[]

  @@index([status, city])
  @@index([pricePhp])
  @@index([publishedAt])
  @@index([agentId])
  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  url         String
  storagePath String?
  alt         String
  position    Int
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, position])
  @@index([propertyId])
  @@map("property_images")
}

model Favorite {
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("favorites")
}

model Inquiry {
  id                   String        @id @default(uuid()) @db.Uuid
  propertyId           String        @db.Uuid
  buyerId              String?       @db.Uuid
  name                 String
  email                String
  phone                String?
  message              String
  preferredViewingDate DateTime?     @db.Date
  status               InquiryStatus @default(new)
  createdAt            DateTime      @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  buyer    User?    @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([buyerId])
  @@index([email, createdAt])
  @@map("inquiries")
}
